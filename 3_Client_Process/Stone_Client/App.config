<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- Identifier announced to the server. Blank = this computer's name. Must not contain ';'. -->
    <add key="ClientId" value="" />
    <!-- IPv4 address of the Stone server. Blank = broadcast discovery on every local network. -->
    <add key="ServerAddress" value="" />
    <!-- Must match IotProtocol.HandshakePort / ClientTcpPort on the server. -->
    <add key="HandshakePort" value="50001" />
    <add key="ClientTcpPort" value="50002" />
    <!-- jpeg or h264. h264 needs ffmpeg.exe; without it the client requests jpeg. -->
    <add key="PreferredEncoding" value="h264" />
    <!-- ffmpeg.exe used to decode H.264. Blank = STONE_FFMPEG_PATH, then next to the exe, then PATH. -->
    <add key="FfmpegPath" value="" />
    <!-- The server forgets a client 30 s after its last handshake; refresh well inside that. -->
    <add key="HandshakeIntervalSeconds" value="10" />
    <add key="OfflineAfterMissedHandshakes" value="3" />
    <!-- Relative paths resolve next to the executable. -->
    <add key="LogDirectory" value="logs" />
  </appSettings>
</configuration>
